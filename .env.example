# ── Supabase (recommended for multi-device / Vercel) ──────────────────────
# Dashboard: https://supabase.com/dashboard → your project
#
# 1) Project Settings → API
#    SUPABASE_URL            = Project URL
#    SUPABASE_SERVICE_ROLE_KEY = service_role secret (server only — never public)
#
# 2) SQL Editor → run file: supabase/schema.sql
#
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional public URL alias (only if you prefer the NEXT_PUBLIC_ name)
# NEXT_PUBLIC_SUPABASE_URL=

# ── Optional fallback: Upstash Redis ──────────────────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Admins ────────────────────────────────────────────────────────────────
# Comma-separated names allowed as first admins
# BOOTSTRAP_ADMIN_NAMES=Lisa,Principal Lee,Your Name

# Required for public / production admin sign-in
ADMIN_PASSWORD=
