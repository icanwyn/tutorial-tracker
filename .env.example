# Optional — required for multi-device / multi-user on Vercel
# Free tier: https://console.upstash.com → create Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — who can register as admin (comma-separated names)
# BOOTSTRAP_ADMIN_NAMES=Lisa,Principal Lee

# Strongly recommended for production / public Vercel
# When set, admin sign-in requires this password (in addition to authorized name)
ADMIN_PASSWORD=
